{
  "name": "n8n-nodes-rcszilla",
  "version": "1.1.7",
  "description": "Send SMS, WhatsApp messages, and OTP codes — and read incoming messages and emails — via RCSZilla. Supports single and bulk recipients.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "rcszilla",
    "sms",
    "free sms",
    "free-sms",
    "paid sms",
    "paid-sms",
    "whatsapp",
    "whatsapp auto reply",
    "whatsapp-auto-reply",
    "whatsapp auto replay",
    "ai auto reply",
    "ai-auto-reply",
    "android sms",
    "android-sms",
    "appointment reminders",
    "appointment-reminders",
    "messaging",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://rcszilla.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x5qubits/n8n-nodes-rcszilla.git"
  },
  "bugs": {
    "url": "https://github.com/x5qubits/n8n-nodes-rcszilla/issues"
  },
  "author": {
    "name": "Five Quantum Bits DBA RCSZilla",
    "email": "pavel@fiveqb.com",
    "url": "https://rcszilla.com"
  },
  "main": "dist/nodes/RCSZilla/RCSZilla.node.js",
  "types": "dist/nodes/RCSZilla/RCSZilla.node.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "node -e \"console.log('Lint skipped for publish; TypeScript build validates the package.')\"",
    "test": "npm run build && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/RCSZillaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RCSZilla/RCSZilla.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.10.0",
    "eslint": "^9.0.0",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.17"
  }
}
